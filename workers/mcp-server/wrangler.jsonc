{
  "name": "miscsubjects-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "MCP_OBJECT", "class_name": "MiscsubjectsMCP" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MiscsubjectsMCP"] }],
  "d1_databases": [
    { "binding": "DB", "database_name": "loop-content-spine", "database_id": "298eb858-37fb-4c73-8be4-135e8feb73fe" }
  ],
  "kv_namespaces": [
    { "binding": "KV", "id": "58b303e666a8431685624e0cfd2fd63f" }
  ],
  "vars": { "BUILD_URL": "https://miscsubjects.com" },
  "workers_dev": true,
  "observability": { "enabled": true }
}
