#!/usr/bin/env bash
# Pre-commit hook: run the protected-file drift guard.
# Commit-message authorization is enforced by .githooks/commit-msg, where Git
# provides the exact message for the commit being created.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# Run guardian and block only drift in files staged by this commit. Unrelated
# protected drift remains reported without deadlocking independent work.
if [ -x "$ROOT/scripts/guard.mjs" ]; then
  RESULT="$(cd "$ROOT" && node scripts/guard.mjs --check --quiet --nojudge 2>/dev/null || echo '{"ok":false}')"
  STAGED_FILES="$(cd "$ROOT" && git diff --cached --name-only --diff-filter=ACM)"
  STAGED_DRIFT="$(RESULT_JSON="$RESULT" STAGED_FILES="$STAGED_FILES" node -e '
    let report = [];
    try { report = JSON.parse(process.env.RESULT_JSON || "{}").report || []; } catch {}
    const staged = new Set((process.env.STAGED_FILES || "").split("\n").filter(Boolean));
    process.stdout.write(String(report.filter(item => staged.has(String(item.path || ""))).length));
  ')"
  if [ "${STAGED_DRIFT:-0}" -gt 0 ]; then
    echo "BLOCKED: guardian reports $STAGED_DRIFT staged protected-file drift(s)." >&2
    echo "Resolve the staged protected paths before committing." >&2
    exit 1
  fi
fi

node "$ROOT/scripts/check-write-law.mjs"
node "$ROOT/scripts/check-protected-features.mjs"
# NO_APPROVED_COPY — a model wrote a fake "owner-accepted copy" clause into the writing-law
# skill on 2026-07-24; two later sessions cited it as authority and shipped the sentence he
# had rejected. He approves style, never copy. This blocks the reintroduction.
node "$ROOT/scripts/check-approved-copy.mjs"
node "$ROOT/scripts/check-operator-gated-copy.mjs"
# THE FAILURE VAULT (owner order 2026-08-04): every owner-named failure mode is one entry in
# failure-vault.json; this gate blocks any commit that reintroduces one.
node "$ROOT/scripts/check-failure-vault.mjs"

exit 0
