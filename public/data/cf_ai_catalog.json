  "parameter_reference": {
    "temperature": {
      "description": "Controls randomness. 0 = deterministic, 2 = very random.",
      "common_range": "0-2",
      "default": 0.7
    },
    "top_p": {
      "description": "Nucleus sampling. Only consider tokens with cumulative probability <= top_p.",
      "common_range": "0-1",
      "default": 0.95
    },
    "max_tokens": {
      "description": "Maximum number of tokens to generate.",
      "common_range": "1-2M (varies by model)",
      "default": 4096
    },
    "frequency_penalty": {
      "description": "Penalize tokens that appear frequently. -2 = encourage repetition, 2 = strongly discourage.",
      "common_range": "-2 to 2",
      "default": 0
    },
    "presence_penalty": {
      "description": "Penalize tokens that have appeared at all. -2 = encourage reuse, 2 = strongly discourage.",
      "common_range": "-2 to 2",
      "default": 0
    },
    "stream": {
      "description": "Stream response tokens as they are generated.",
      "type": "boolean",
      "default": false
    },
    "response_format": {
      "description": "Force JSON or text output.",
      "type": "object",
      "options": [
        {
          "type": "text"
        },
        {
          "type": "json_object"
        }
      ]
    },
    "tools": {
      "description": "Array of function definitions the model can call.",
      "type": "array"
    },
    "tool_choice": {
      "description": "How the model should use tools. 'auto', 'none', or force a specific function.",
      "type": "object"
    },
    "seed": {
      "description": "Deterministic seed for reproducible outputs.",
      "type": "integer"
    },
    "stop": {
      "description": "Array of strings that will stop generation.",
      "type": "array",
      "items": "string"
    },
    "n": {
      "description": "Number of completions to generate.",
      "type": "integer",
      "min": 1,
      "max": 10,
      "default": 1
    },
    "reasoning_effort": {
      "description": "Control reasoning depth. none = no reasoning, high = maximum reasoning.",
      "type": "string",
      "options": [
        "none",
        "low",
        "medium",
        "high"
      ],
      "default": "none"
    },
    "messages": {
      "description": "Array of message objects. Required for all chat completions.",
      "type": "array",
      "required": true
    }
  }
